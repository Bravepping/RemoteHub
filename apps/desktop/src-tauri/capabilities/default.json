{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local main window; native Rust tray only, no JavaScript menu/tray, shell, filesystem or network plugins",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "allow-get-runtime-info",
    "allow-run-capture-probe",
    "allow-p004-start-loopback-probe",
    "allow-p004-signal",
    "allow-p004-get-stats",
    "allow-p004-stop-loopback-probe",
    "allow-p004-save-report",
    "allow-p004-lan-local-ip",
    "allow-p004-lan-start",
    "allow-p004-lan-signal",
    "allow-p004-lan-stats",
    "allow-p004-lan-metrics",
    "allow-p004-lan-stop",
    "allow-p004-lan-save",
    "allow-run-v2-loopback-diagnostic",
    "allow-p006-interfaces",
    "allow-p006-start",
    "allow-p006-ready",
    "allow-p006-signal",
    "allow-p006-stats",
    "allow-p006-metrics",
    "allow-p006-stop",
    "allow-p006-save"
  ]
}
