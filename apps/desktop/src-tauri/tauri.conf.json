{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteHub",
  "version": "0.1.0",
  "identifier": "local.remotehub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RemoteHub · Phase 0", "width": 1080, "height": 780, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
