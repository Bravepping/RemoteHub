{
  "name": "remotehub-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @remotehub/desktop dev",
    "desktop": "pnpm --filter @remotehub/desktop tauri dev",
    "build": "pnpm --filter @remotehub/desktop build",
    "typecheck": "pnpm --filter @remotehub/desktop typecheck",
    "test": "pnpm --filter @remotehub/desktop test",
    "lint": "prettier --check apps/desktop/src apps/desktop/*.ts scripts/*.mjs scripts/quality/*",
    "format": "prettier --write apps/desktop/src apps/desktop/*.ts scripts/*.mjs scripts/quality/*",
    "test:e2e": "pnpm --filter @remotehub/desktop test:e2e",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "verify:p1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p101.ps1",
    "verify:p102": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p102.ps1",
    "verify:p103": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p103.ps1",
    "verify:p104": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p104.ps1",
    "verify:p105": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p105.ps1",
    "verify:p106": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p106.ps1",
    "verify:p201": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p201.ps1",
    "verify:p3": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p3.ps1"
  },
  "devDependencies": { "prettier": "3.10.1" }
}
