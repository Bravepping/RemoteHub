{
  "name": "remotehub-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @remotehub/desktop dev",
    "desktop": "pnpm --filter @remotehub/desktop tauri dev",
    "build": "pnpm --filter @remotehub/desktop build",
    "installer:windows": "pnpm --filter @remotehub/desktop tauri build --config src-tauri/tauri.windows-installer.json --target x86_64-pc-windows-msvc --no-sign --features p3-lan -- --locked --no-default-features",
    "typecheck": "pnpm --filter @remotehub/desktop typecheck",
    "test": "pnpm --filter @remotehub/desktop test",
    "lint": "prettier --check apps/desktop/src apps/desktop/*.ts scripts/*.mjs",
    "format": "prettier --write apps/desktop/src apps/desktop/*.ts scripts/*.mjs",
    "test:e2e": "pnpm --filter @remotehub/desktop test:e2e",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "verify": "node scripts/checks.mjs"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
